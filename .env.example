# Copy to .env; never commit credentials. Use --mock for a credential-free demo.
MOCK=0
MOCK_REALTIME=0
MOCK_SPEED=4
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
DATAAGENT_REGION_ID=cn-hangzhou
# Optional custom API hostname; omit protocol and path. Empty uses the SDK endpoint.
END_POINT=
DATAAGENT_AGENT_NAME=dataworks_data_agent
RESOURCE_GROUP_ID=
SESSION_SOURCE=data-agent-openapi-demo
PORT=3000
CORS_ORIGIN=http://localhost:5173
# npm start sets this automatically. --lan uses a same-origin streaming proxy.
VITE_API_BASE=http://127.0.0.1:3000
LOG_LEVEL=info
# DAS_ENV=demo selects .env.demo instead of .env (not merged).
