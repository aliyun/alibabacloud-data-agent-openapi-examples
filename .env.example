# ============================================================================
# DataAgent OpenAPI 样板工程 —— 环境变量样例
#
# 用法：cp .env.example .env  然后填值。.env 已在 .gitignore 里，绝不要提交。
#
# 只想先看看界面长什么样、跑通流程？把 MOCK 设成 1，其余全部留空即可。
# ============================================================================

# ---------------------------------------------------------------------------
# Mock 模式：1 = 完全不调真实接口，回放本仓库录制的真实帧流（含 rid-less 污染、
# 断流、幽灵化、并发拒绝、prompt 不派发（零帧只有 POP 回执）五种形态），无需任何凭证。
# ---------------------------------------------------------------------------
MOCK=0

# ---------------------------------------------------------------------------
# MOCK 回放的时序（只在 MOCK=1 时有意义）
#
# 默认把过长的帧间隔压平到 400ms，再叠一个倍速：录制件里长轮 901 帧跑了 191 秒、
# 断流那份 1201 帧跑了 258 秒（正好落在实测的 218~258s 断流墙上），按真实间隔等完一轮当演示等不起。
# 压平和倍速**只改等待时间**，帧序、帧数、帧内容、相对顺序全部保真。
#
# MOCK_REALTIME=1 时按录制时的真实时间间隔回放（用来验证前端在真实节奏下的表现），
# 此时 MOCK_SPEED 不生效。
# ---------------------------------------------------------------------------
MOCK_REALTIME=0
MOCK_SPEED=4

# ---------------------------------------------------------------------------
# 凭证（MOCK=0 时必填）
#
# 强烈建议单独建一个 RAM 用户，不要用主账号 AK/SK。
# 创建路径：RAM 控制台 → 身份管理 → 用户 → 创建用户 → 勾选「使用永久 AccessKey 访问」
#          → 给该用户授权 DataWorks 相关权限策略
#
# 本工程只认这两个变量：不读 ~/.aliyun/config.json，不调用 aliyun CLI。
# （本机的 aliyun CLI profile 若是 OAuth 模式，SDK 的凭证链拾取不到，别指望复用。）
# ---------------------------------------------------------------------------
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------------------
# 地域：DataWorks 实例所在的 region，例如 cn-hangzhou / cn-shanghai / cn-wulanchabu
#
# 有默认值 cn-hangzhou，所以不是必填；但**实例不在杭州时必须改**，
# 否则请求会打到另一个 region 的网关，那边根本没有你的实例。
# ---------------------------------------------------------------------------
DATAAGENT_REGION_ID=cn-hangzhou

# ---------------------------------------------------------------------------
# 上游域名（可选）
#
# 留空 ⇒ SDK 按 DATAAGENT_REGION_ID 走内置映射，自动拼成
#        dataworks.{region}.aliyuncs.com（生产 region 用这条，不用自己填）。
# 非空 ⇒ 直接当 host 用，覆盖映射。
#
# 什么时候必须填：要接**预发 / 日常**这类内置映射表里没有的网关。
# 例如某环境的预发网关填 PRE-GATEWAY.example.com（具体值见内部环境配置，
# 不写进本仓库）——不填的话，无论 region 怎么写，SDK 推导出来的永远是生产域名，
# 请求会打到生产去。注意只填域名（host），不要带 https:// 或路径。
# ---------------------------------------------------------------------------
END_POINT=

# ---------------------------------------------------------------------------
# 环境切换：DAS_ENV=<name> 时，本工程改读 .env.<name> 而不是 .env。
#
# 它**不写在本文件里**，而是命令行注入，用来在多个上游环境间切换：
#     DAS_ENV=beijing-pre npm run dev      # 读 .env.beijing-pre
#     DAS_ENV=beijing-pre npm run check    # 自检也走同一份
# 每个 .env.<name> 都是自包含的一份（region/endpoint/资源组/凭证各写各的），
# 选中谁就只用谁，不与 .env 叠加。加了 DAS_ENV 却找不到对应文件会直接报错退出，
# 不会静默回落到 .env（那会让你以为在跑预发、其实打到了生产）。
# 要新增环境：cp .env.example .env.<name> 填好即可，无需改代码或 package.json。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Agent 名
#
# 实测：ListAgents 恒只返回 2 个 chatbi agent，找不到 data agent（服务端硬编码），
# 所以不要靠列表接口去发现，直接写死这个名字。
# CreateAgentSession 只认 Meta.Agent.AgentName 这一个位置。
# ---------------------------------------------------------------------------
DATAAGENT_AGENT_NAME=dataworks_data_agent

# ---------------------------------------------------------------------------
# Serverless 资源组 ID
#
# 账号下 DataWorks 运行实例为零时必填；即使填了，服务端也不校验有效性
# （写个不存在的 ID 一样建会话成功，所以别把它当排错信号）。
# 控制台：DataWorks → 资源组列表 → Serverless 资源组 → 复制 ID
# ---------------------------------------------------------------------------
RESOURCE_GROUP_ID=

# ---------------------------------------------------------------------------
# 会话归属标记
#
# 左栏只列出带这个来源标记的会话，避免和你手工建的会话混在一起。
# 实测：ListAgentSessions 的 AgentName 必填；SessionSourceList / TagList / SessionId
#      三个过滤器生效，SessionTitle 过滤器被静默忽略 —— 所以标题搜索必须在前端做。
# ---------------------------------------------------------------------------
SESSION_SOURCE=data-agent-openapi-demo

# ---------------------------------------------------------------------------
# 后端端口
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# 允许的前端来源（CORS）
#
# 流式响应类型是 application/x-ndjson，属于非简单类型，浏览器会先发预检请求，
# 后端必须正确响应 OPTIONS，否则前端第一个 POST 就失败。
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# 前端连后端的地址
#
# 本工程不用 Vite dev proxy：proxy 对长连接有缓冲/超时的整类风险，直连一次消掉，
# 而且 dev 与生产形态一致。改后端端口时这里要同步改。
# ---------------------------------------------------------------------------
VITE_API_BASE=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# 后端日志级别（Fastify/pino）：fatal | error | warn | info | debug | trace
#
# 默认 info。排查流式问题时调 debug：会多出每条 wire 事件的写入与心跳。
# 任何级别都**不会**打印凭证——配置里只有 present / missing 两种取值。
# ---------------------------------------------------------------------------
LOG_LEVEL=info
