# Copy to .env; never commit credentials. Use --mock for a credential-free demo.
MOCK=0
MOCK_REALTIME=0
MOCK_SPEED=4
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional: only when AK/SK are from the same STS response.
ALIBABA_CLOUD_SECURITY_TOKEN=
DATAAGENT_REGION_ID=cn-hangzhou
# Optional custom API hostname; omit protocol and path. Empty uses the SDK endpoint.
END_POINT=
DATAAGENT_AGENT_NAME=dataworks_data_agent
# Creation defaults; omitted model/reasoning inherit the published Agent config.
DATAAGENT_MODEL=
DATAAGENT_MODE=yolo
DATAAGENT_REASONING_EFFORT=
DATAAGENT_MODELS=
# ACS does not require a resource group or ProjectId.
RESOURCE_GROUP_ID=
SESSION_SOURCE=data-agent-openapi-demo
PORT=3000
CORS_ORIGIN=http://localhost:5173
# npm start sets this automatically. --lan uses a same-origin streaming proxy.
VITE_API_BASE=http://127.0.0.1:3000
LOG_LEVEL=info
# DAS_ENV=demo selects .env.demo instead of .env (not merged).

# Optional standalone AssumeRole example; ignored by normal npm start.
# DATAAGENT_ROLE_ARN=acs:ram::<account-id>:role/<role-name>
# DATAAGENT_SOURCE_IDENTITY=trusted-business-user-id
