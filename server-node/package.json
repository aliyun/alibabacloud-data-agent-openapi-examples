{
  "name": "@das/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify 代理层：唯一持有 AK/SK 的进程，把 SDK 的 async generator 转成 NDJSON",
  "scripts": {
    "dev": "tsx watch --exclude \"**/node_modules/**\" --exclude \"**/.vite/**\" --exclude \"**/dist/**\" src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsx src/check.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@alicloud/dataworks-public20240518": "9.9.1",
    "@alicloud/openapi-core": "^1.0.8",
    "@darabonba/typescript": "^1.0.5",
    "@das/shared": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
