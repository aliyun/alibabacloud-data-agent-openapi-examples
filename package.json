{
  "name": "data-agent-openapi-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataWorks DataAgent OpenAPI 样板工程：Fastify 代理 + React 三栏前端，把实测出来的接口约束固化成代码",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "workspaces": [
    "shared",
    "server-node",
    "web"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs",
    "dev:server": "npm run dev --workspace server-node",
    "dev:web": "npm run dev --workspace web",
    "check": "npm run check --workspace server-node --",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace server-node && npm run typecheck --workspace web",
    "build": "npm run typecheck && npm run build --workspace web"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "concurrently": "^9.1.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
